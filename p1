        "%%shell\n",
        "cat <<EOF > /content/sort_benchmarks.cpp\n",
        "#include <iostream>\n",
        "#include <vector>\n",
        "#include <cstdlib>\n",
        "#include <ctime>\n",
        "#include <chrono>\n",
        "\n",
        "using namespace std;\n",
        "using namespace chrono;\n",
        "\n",
        "// Bubble Sort\n",
        "void bubbleSort(vector<int> &a)\n",
        "{\n",
        "    int n = a.size();\n",
        "\n",
        "    for (int i = 0; i < n - 1; i++)\n",
        "        for (int j = 0; j < n - i - 1; j++)\n",
        "            if (a[j] > a[j + 1])\n",
        "                swap(a[j], a[j + 1]);\n",
        "}\n",
        "\n",
        "// Selection Sort\n",
        "void selectionSort(vector<int> &a)\n",
        "{\n",
        "    int n = a.size();\n",
        "\n",
        "    for (int i = 0; i < n - 1; i++)\n",
        "    {\n",
        "        int minIndex = i;\n",
        "\n",
        "        for (int j = i + 1; j < n; j++)\n",
        "            if (a[j] < a[minIndex])\n",
        "                minIndex = j;\n",
        "\n",
        "        swap(a[i], a[minIndex]);\n",
        "    }\n",
        "}\n",
        "\n",
        "// Insertion Sort\n",
        "void insertionSort(vector<int> &a)\n",
        "{\n",
        "    int n = a.size();\n",
        "\n",
        "    for (int i = 1; i < n; i++)\n",
        "    {\n",
        "        int key = a[i];\n",
        "        int j = i - 1;\n",
        "\n",
        "        while (j >= 0 && a[j] > key)\n",
        "        {\n",
        "            a[j + 1] = a[j];\n",
        "            j--;\n",
        "        }\n",
        "\n",
        "        a[j + 1] = key;\n",
        "    }\n",
        "}\n",
        "\n",
        "// Merge Sort\n",
        "void merge(vector<int> &a, int left, int mid, int right)\n",
        "{\n",
        "    vector<int> temp;\n",
        "    int i = left, j = mid + 1;\n",
        "\n",
        "    while (i <= mid && j <= right)\n",
        "    {\n",
        "        if (a[i] < a[j])\n",
        "            temp.push_back(a[i++]);\n",
        "        else\n",
        "            temp.push_back(a[j++]);\n",
        "    }\n",
        "\n",
        "    while (i <= mid)\n",
        "        temp.push_back(a[i++]);\n",
        "\n",
        "    while (j <= right)\n",
        "        temp.push_back(a[j++]);\n",
        "\n",
        "    for (int k = 0; k < temp.size(); k++)\n",
        "        a[left + k] = temp[k];\n",
        "}\n",
        "\n",
        "void mergeSort(vector<int> &a, int left, int right)\n",
        "{\n",
        "    if (left < right)\n",
        "    {\n",
        "        int mid = (left + right) / 2;\n",
        "\n",
        "        mergeSort(a, left, mid);\n",
        "        mergeSort(a, mid + 1, right);\n",
        "        merge(a, left, mid, right);\n",
        "    }\n",
        "}\n",
        "\n",
        "// Quick Sort\n",
        "int partition(vector<int> &a, int low, int high)\n",
        "{\n",
        "    int pivot = a[high];\n",
        "    int i = low - 1;\n",
        "\n",
        "    for (int j = low; j < high; j++)\n",
        "    {\n",
        "        if (a[j] < pivot)\n",
        "        {\n",
        "            i++;\n",
        "            swap(a[i], a[j]);\n",
        "        }\n",
        "    }\n",
        "\n",
        "    swap(a[i + 1], a[high]);\n",
        "    return i + 1;\n",
        "}\n",
        "\n",
        "void quickSort(vector<int> &a, int low, int high)\n",
        "{\n",
        "    if (low < high)\n",
        "    {\n",
        "        int p = partition(a, low, high);\n",
        "\n",
        "        quickSort(a, low, p - 1);\n",
        "        quickSort(a, p + 1, high);\n",
        "    }\n",
        "}\n",
        "\n",
        "int main()\n",
        "{\n",
        "    int n = 100;\n",
        "    vector<int> arr(n), temp;\n",
        "\n",
        "    srand(time(0));\n",
        "\n",
        "    for (int i = 0; i < n; i++)\n",
        "        arr[i] = rand() % 1000;\n",
        "\n",
        "    cout << \"Number of Elements = \" << n << \"\\n\\n\";\n",
        "\n",
        "    auto start = high_resolution_clock::now();\n",
        "    temp = arr;\n",
        "    bubbleSort(temp);\n",
        "    auto end = high_resolution_clock::now();\n",
        "    cout << \"Bubble Sort    : \"\n",
        "         << duration_cast<microseconds>(end - start).count()\n",
        "         << \" microseconds\\n\";\n",
        "\n",
        "    start = high_resolution_clock::now();\n",
        "    temp = arr;\n",
        "    selectionSort(temp);\n",
        "    end = high_resolution_clock::now();\n",
        "    cout << \"Selection Sort : \"\n",
        "         << duration_cast<microseconds>(end - start).count()\n",
        "         << \" microseconds\\n\";\n",
        "\n",
        "    start = high_resolution_clock::now();\n",
        "    temp = arr;\n",
        "    insertionSort(temp);\n",
        "    end = high_resolution_clock::now();\n",
        "    cout << \"Insertion Sort : \"\n",
        "         << duration_cast<microseconds>(end - start).count()\n",
        "         << \" microseconds\\n\";\n",
        "\n",
        "    start = high_resolution_clock::now();\n",
        "    temp = arr;\n",
        "    mergeSort(temp, 0, n - 1);\n",
        "    end = high_resolution_clock::now();\n",
        "    cout << \"Merge Sort     : \"\n",
        "         << duration_cast<microseconds>(end - start).count()\n",
        "         << \" microseconds\\n\";\n",
        "\n",
        "    start = high_resolution_clock::now();\n",
        "    temp = arr;\n",
        "    quickSort(temp, 0, n - 1);\n",
        "    end = high_resolution_clock::now();\n",
        "    cout << \"Quick Sort     : \"\n",
        "         << duration_cast<microseconds>(end - start).count()\n",
        "         << \" microseconds\\n\";\n",
        "\n",
        "    return 0;\n",
        "}\n"
      ]
    }
